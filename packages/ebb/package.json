{
  "name": "@velella/ebb",
  "version": "0.1.0",
  "description": "The open almanac of software end-of-life.",
  "keywords": [
    "end-of-life",
    "eol",
    "deprecation",
    "lifecycle",
    "purl",
    "vers",
    "registry"
  ],
  "homepage": "https://github.com/velella-sh/ebb#readme",
  "bugs": {
    "url": "https://github.com/velella-sh/ebb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velella-sh/ebb.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/src/*.d.ts",
      "import": "./dist/src/*.js",
      "default": "./dist/src/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "data",
    "registry",
    "schemas",
    "LICENSE",
    "LICENSE-DATA",
    "ATTRIBUTION.md",
    "!registry/sources.lock.json",
    "!**/*.map"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "tsc -b tsconfig.json && node --test \"dist/tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@sigstore/bundle": "^5.0.0",
    "@sigstore/protobuf-specs": "^0.5.2",
    "@sigstore/verify": "^4.1.2",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/semver": "^7.8.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
