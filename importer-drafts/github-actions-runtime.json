      "event": "end-of-support",
      "title": "Unsupported actions/cache runtime",
      "summary": "This release predates the action's Node.js 24 runtime. GitHub no longer provides Node.js 20 on Actions runners.",
      "severity": "high",
      "replacement": "actions/cache@v5 or later",
      "deadline": "2026-09-23",
      "sources": [
        {
          "title": "Node 20 is no longer available in GitHub Actions",
